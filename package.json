{
  "name": "@snowamberx/dsh-role-router",
  "version": "0.3.0",
  "description": "Route DeepSeek Harness agent requests by role: planner model in plan mode, default model otherwise, subagent model for subagents.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "bundle": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-connection": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-plan-mode": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-store": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.2"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@types/react": "~18.3.1"
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bundle",
    "model-routing"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnowAmberX/dsh-role-router.git"
  }
}
