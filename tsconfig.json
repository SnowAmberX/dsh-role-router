{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "lib",
    "declaration": true,
    "declarationDir": "lib/types",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmitOnError": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "preserveSymlinks": true,
    "types": [],
    // The profile's packages carry their own nested @deepseek-ai/cordis
    // symlinks; under preserveSymlinks each nested path is a distinct module
    // instance, so plugin-side `declare module '@deepseek-ai/cordis'`
    // augmentations (e.g. the credentials forwarded-event declarations) never
    // reach the Events interface this project resolves. Pinning the one
    // module to a single file unifies the instance for every importer.
    "paths": {
      "@deepseek-ai/cordis": ["./node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["tests", "node_modules", "lib"]
}
